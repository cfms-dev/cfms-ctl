-- ============================================================================
-- CFMS Schema Migration SQL ({{ dialect }})
-- Revision: {{ from_revision }} -> {{ to_revision }}
-- Generated by cfms-ctl schema evolution engine
-- Max Risk Level: {{ max_risk_level }}{% if has_blocking_risks %} (BLOCKING RISKS PRESENT - REVIEW BEFORE APPLYING){% endif %}
-- ============================================================================
{% if findings %}
-- Risk Audit Findings:
{% for f in findings %}--   * [{{ f.level }} {{ f.code }}] {{ f.summary }}{% if f.preflight_evidence %} [Preflight: {{ f.preflight_evidence }}]{% endif %}
{% endfor %}{% endif %}{% if warnings %}
-- Diagnostics / Warnings:
{% for w in warnings %}--   ! {{ w }}
{% endfor %}{% endif %}
{% if needs_sqlite_fk_toggle %}PRAGMA foreign_keys = OFF;
{% endif %}{% if wrap_in_transaction %}BEGIN;
{% endif %}
{% for block in op_blocks %}
-- Phase: {{ block.phase }}
{% for comment in block.risk_comments %}-- {{ comment }}
{% endfor %}{% for stmt in block.statements %}{{ stmt }};
{% endfor %}{% endfor %}
{% if wrap_in_transaction %}COMMIT;
{% endif %}{% if needs_sqlite_fk_toggle %}PRAGMA foreign_keys = ON;
PRAGMA foreign_key_check;
{% endif %}{% if set_alembic_version_sql %}{{ set_alembic_version_sql }};
{% endif %}
